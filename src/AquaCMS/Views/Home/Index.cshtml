@model HomeViewModel
@*
    Trang chủ — Banner, Danh mục, Sản phẩm nổi bật, Bài viết mới.
    SEO: JSON-LD Organization structured data.
*@

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <style>
        .hero-swiper { width: 100%; height: auto; overflow: hidden; position: relative; }
        .swiper-wrapper { display: flex !important; }
        .swiper-slide { flex-shrink: 0; width: 100%; height: 100%; position: relative; }
        
        /* Hiệu ứng hover danh mục */
        .category-swiper { padding: 40px 0 !important; margin: -40px 0 !important; }
        .category-swiper .swiper-slide { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .category-swiper .swiper-slide:hover { transform: scale(1.15); z-index: 10; }
    </style>
}

@* ===== BANNER SLIDER ===== *@
@if (Model.Settings.ShowBanners && Model.Banners.Count > 0)
{
    <section class="relative group overflow-hidden">
        <div class="swiper hero-swiper">
            <div class="swiper-wrapper">
                @foreach (var banner in Model.Banners)
                {
                    <div class="swiper-slide relative bg-gray-100 overflow-hidden min-h-[550px] flex items-center" 
                         style="@(!string.IsNullOrEmpty(banner.Image) ? $"background-image: url('{banner.Image}'); background-size: cover; background-position: center;" : "")">
                        
                        @if (!string.IsNullOrEmpty(banner.Image))
                        {
                            <div class="absolute inset-0 bg-black/30"></div>
                        }

                        <div class="relative max-w-7xl mx-auto px-4 py-20 w-full">
                            <div class="max-w-2xl">
                                <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">@banner.Title</h2>
                                @if (!string.IsNullOrEmpty(banner.Description))
                                {
                                    <div class="text-white/90 mb-8">@Html.Raw(banner.Description)</div>
                                }
                                <a href="@(banner.LinkUrl ?? "/san-pham")" class="inline-block bg-primary text-white px-8 py-3 rounded-lg font-bold hover:opacity-90 transition">
                                    Khám phá ngay
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
        </div>
    </section>
}

@* ===== DANH MỤC SẢN PHẨM ===== *@
@if (Model.Categories.Count > 0)
{
    <section class="max-w-7xl mx-auto px-4 py-12 relative group/catsection">
        <div class="text-center mb-10">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Danh mục sản phẩm</h2>
        </div>

        @* Thêm px-6 để nút không bị cắt *@
        <div class="swiper category-swiper !pb-4 !px-10">
            <div class="swiper-wrapper">
                @foreach (var cat in Model.Categories)
                {
                    <div class="swiper-slide">
                        <a href="/danh-muc/@cat.Slug"
                           class="group flex flex-col items-center text-center">
                            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full flex items-center justify-center overflow-hidden mb-3">
                                @if (!string.IsNullOrEmpty(cat.Image))
                                {
                                    <img src="@cat.Image"
                                         alt="@cat.Name"
                                         class="w-full h-full object-cover rounded-full"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-primary">
                                        <i data-lucide="package" class="w-8 h-8"></i>
                                    </div>
                                }
                            </div>
                            <h3 class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-primary transition-colors line-clamp-2 px-1">@cat.Name</h3>
                        </a>
                    </div>
                }
            </div>
            
            <!-- Navigation Custom Icons -->
            <div class="category-next swiper-button-next !w-10 !h-10 !bg-white !shadow-md !rounded-full !text-gray-600 hover:!text-primary after:!content-none !right-2 transition-all hover:scale-110">
                <i data-lucide="chevron-right" class="w-6 h-6"></i>
            </div>
            <div class="category-prev swiper-button-prev !w-10 !h-10 !bg-white !shadow-md !rounded-full !text-gray-600 hover:!text-primary after:!content-none !left-2 transition-all hover:scale-110">
                <i data-lucide="chevron-left" class="w-6 h-6"></i>
            </div>
        </div>
    </section>
}

@* ===== SẢN PHẨM NỔI BẬT ===== *@
@if (Model.FeaturedProducts.Count > 0)
{
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between mb-12">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900">Sản phẩm nổi bật</h2>
                    <p class="text-gray-500 mt-2">Được lựa chọn nhiều nhất</p>
                </div>
                <a href="/san-pham" class="text-primary hover:underline font-medium flex items-center gap-1">
                    Xem tất cả
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

@* ===== SẢN PHẨM THEO DANH MỤC (Tự động cập nhật) ===== *@
@foreach (var cat in Model.CategoriesWithProducts)
{
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">@cat.Name</h2>
                </div>
                <a href="/danh-muc/@cat.Slug" class="text-sm text-primary hover:underline font-medium flex items-center gap-1">
                    Xem tất cả @cat.Name
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var product in cat.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

@* ===== BÀI VIẾT MỚI NHẤT ===== *@
@if (Model.LatestPosts.Count > 0)
{
    <section class="max-w-7xl mx-auto px-4 py-16">
        <div class="flex items-center justify-between mb-12">
            <div>
                <h2 class="text-3xl font-bold text-gray-900">Kiến thức mới</h2>
                <p class="text-gray-500 mt-2">Bài viết & hướng dẫn kỹ thuật</p>
            </div>
            <a href="/kien-thuc" class="text-primary hover:underline font-medium flex items-center gap-1">
                Xem tất cả
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var post in Model.LatestPosts.Take(3))
            {
                <a href="@post.SeoUrl"
                   class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition overflow-hidden">
                    @if (!string.IsNullOrEmpty(post.Image))
                    {
                        <div class="aspect-[16/9] overflow-hidden">
                            <img src="@post.Image"
                                 alt="@post.Title"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                                 loading="lazy" />
                        </div>
                    }
                    <div class="p-5">
                        <h3 class="font-semibold text-gray-800 group-hover:text-primary transition line-clamp-2 mb-2">
                            @post.Title
                        </h3>
                        @if (!string.IsNullOrEmpty(post.Excerpt))
                        {
                            <p class="text-sm text-gray-500 line-clamp-2">@post.Excerpt</p>
                        }
                        <div class="flex items-center gap-4 mt-3 text-xs text-gray-400">
                            <span class="flex items-center gap-1">
                                <i data-lucide="user" class="w-3 h-3"></i> @post.Author
                            </span>
                            @if (!string.IsNullOrEmpty(post.ReadTime))
                            {
                                <span class="flex items-center gap-1">
                                    <i data-lucide="clock" class="w-3 h-3"></i> @post.ReadTime
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
}

@* ===== JSON-LD: Organization (SEO structured data) ===== *@
@section StructuredData {
    @{
        var jsonLd = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Organization",
            ["name"] = Model.Settings.CompanyName ?? "",
            ["url"] = $"{Context.Request.Scheme}://{Context.Request.Host}"
        };
        if (!string.IsNullOrEmpty(Model.Settings.Logo)) jsonLd["logo"] = Model.Settings.Logo;
        if (!string.IsNullOrEmpty(Model.Settings.Phone)) jsonLd["telephone"] = Model.Settings.Phone;
        if (!string.IsNullOrEmpty(Model.Settings.Email)) jsonLd["email"] = Model.Settings.Email;
        var sameAs = new List<string>();
        if (!string.IsNullOrEmpty(Model.Settings.Facebook)) sameAs.Add(Model.Settings.Facebook);
        if (!string.IsNullOrEmpty(Model.Settings.Youtube)) sameAs.Add(Model.Settings.Youtube);
        if (sameAs.Count > 0) jsonLd["sameAs"] = sameAs;
    }
    <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsonLd))</script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Hero Swiper
            new Swiper('.hero-swiper', {
                loop: true,
                speed: 800,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                grabCursor: true,
            });

            // Category Swiper
            new Swiper('.category-swiper', {
                loop: true,
                slidesPerView: 3,
                spaceBetween: 16,
                navigation: {
                    nextEl: '.category-next',
                    prevEl: '.category-prev',
                },
                breakpoints: {
                    640: { slidesPerView: 4, spaceBetween: 20 },
                    768: { slidesPerView: 6, spaceBetween: 24 },
                    1024: { slidesPerView: 8, spaceBetween: 24 },
                },
                grabCursor: true,
            });
        });
    </script>
}
