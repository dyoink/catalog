@model Product
@using System.Text.Json
@*
    Admin: Form thêm/sửa sản phẩm — dùng chung cho Create và Edit.
    Bao gồm: thông tin cơ bản, SEO fields, content blocks editor.
*@
@{
    var isEdit = Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? $"Sửa: {Model.Name}" : "Thêm sản phẩm mới";
    var categories = ViewData["Categories"] as List<Category> ?? new();
    
    // Chuẩn bị JSON an toàn
    var initialJson = "[]";
    if (Model.Content?.ContentBlocks != null)
    {
        initialJson = JsonSerializer.Serialize(Model.Content.ContentBlocks);
    }
}

<div class="max-w-4xl space-y-6">
    @* Header *@
    <div class="flex items-center gap-4">
        <a href="/admin/products" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
    </div>

    <form method="post"
          action="@(isEdit ? $"/admin/products/edit/{Model.Id}" : "/admin/products/create")"
          enctype="multipart/form-data"
          class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        @* Return parameters to preserve list state *@
        <input type="hidden" name="returnPage" value="@ViewBag.ReturnPage" />
        <input type="hidden" name="returnSearch" value="@ViewBag.ReturnSearch" />
        <input type="hidden" name="returnStatus" value="@ViewBag.ReturnStatus" />
        <input type="hidden" name="returnCategoryId" value="@ViewBag.ReturnCategoryId" />

        @* ===== THÔNG TIN CƠ BẢN ===== *@
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
            <h2 class="font-bold text-gray-800 text-lg border-b pb-3">Thông tin cơ bản</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                @* Tên sản phẩm *@
                <div class="md:col-span-2">
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">
                        Tên sản phẩm <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" required
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50 focus:border-primary"
                           placeholder="VD: Máy sục khí ao tôm 750W" />
                </div>

                @* Slug *@
                <div>
                    <label asp-for="Metadata.Slug" class="block text-sm font-medium text-gray-700 mb-1">Slug (URL)</label>
                    <input asp-for="Metadata.Slug"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="Tự động tạo từ tên" />
                    <p class="text-xs text-gray-400 mt-1">Để trống để tự động tạo từ tên sản phẩm</p>
                </div>

                @* SKU *@
                <div>
                    <label asp-for="Sku" class="block text-sm font-medium text-gray-700 mb-1">Mã SKU</label>
                    <input asp-for="Sku"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="VD: MAY-SUC-KHI-750" />
                </div>

                @* Danh mục *@
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 mb-1">Danh mục</label>
                    <select asp-for="CategoryId"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50">
                        <option value="">— Chọn danh mục —</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>

                @* Giá gốc *@
                <div>
                    <label asp-for="Finance.Price" class="block text-sm font-medium text-gray-700 mb-1">Giá gốc (VNĐ)</label>
                    <input asp-for="Finance.Price" type="number" step="1000" min="0"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="Để trống = Liên hệ báo giá" />
                </div>

                @* Giá giảm *@
                <div>
                    <label asp-for="Finance.DiscountPrice" class="block text-sm font-medium text-gray-700 mb-1">Giá sau giảm (VNĐ)</label>
                    <input asp-for="Finance.DiscountPrice" type="number" step="1000" min="0"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="Để trống = Không giảm giá" />
                </div>

                @* Trạng thái *@
                <div>
                    <label asp-for="Status" class="block text-sm font-medium text-gray-700 mb-1">Trạng thái</label>
                    <select asp-for="Status"
                            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50">
                        <option value="Available" selected="@(Model.Status == ProductStatus.Available)">Hiển thị</option>
                        <option value="Hidden" selected="@(Model.Status == ProductStatus.Hidden)">Ẩn</option>
                        <option value="OutOfStock" selected="@(Model.Status == ProductStatus.OutOfStock)">Hết hàng</option>
                    </select>
                </div>

                @* Nổi bật *@
                <div class="flex items-center gap-6 pt-6">
                    <div class="flex items-center gap-2">
                        <input asp-for="Finance.IsFeatured" type="checkbox" class="rounded text-primary focus:ring-primary" />
                        <label asp-for="Finance.IsFeatured" class="text-sm text-gray-700">Sản phẩm nổi bật</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input asp-for="Finance.ShowPrice" type="checkbox" class="rounded text-primary focus:ring-primary" />
                        <label asp-for="Finance.ShowPrice" class="text-sm text-gray-700">Hiển thị giá</label>
                    </div>
                </div>
            </div>

            @* Mô tả ngắn *@
            <div>
                <label asp-for="Content.Description" class="block text-sm font-medium text-gray-700 mb-1">Mô tả ngắn</label>
                <textarea asp-for="Content.Description" rows="3"
                          class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                          placeholder="Mô tả tóm tắt sản phẩm (hiện ở trang detail)"></textarea>
            </div>
        </div>

        @* ===== HÌNH ẢNH & VIDEO ===== *@
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
            <h2 class="font-bold text-gray-800 text-lg border-b pb-3">Hình ảnh & Video</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="Content.Image" class="block text-sm font-medium text-gray-700 mb-1">URL ảnh đại diện</label>
                    <input asp-for="Content.Image" data-preview="#productImagePreview"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="https://... hoặc /uploads/..." />
                    
                    <div class="mt-4 flex items-start gap-4">
                        <div class="flex-1 space-y-3">
                            <label class="block text-xs text-gray-500">Hoặc upload trực tiếp (≤ 20MB):</label>
                            <input type="file" name="imageFile" accept="image/*" data-preview="#productImagePreview" data-crop="1:1"
                                   class="block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary/10 file:text-primary hover:file:bg-primary/20" />
                        </div>

                        <div id="productImagePreview" class="@(string.IsNullOrEmpty(Model.Content?.Image) ? "hidden" : "") flex-shrink-0">
                            <img src="@(Model.Content?.Image ?? "")" alt="Preview"
                                 class="w-32 h-32 rounded-lg object-cover border border-gray-200 shadow-sm" />
                            <p class="text-[10px] text-center text-gray-400 mt-1">Xem trước</p>
                        </div>
                    </div>
                </div>
                <div>
                    <label asp-for="Content.VideoUrl" class="block text-sm font-medium text-gray-700 mb-1">URL video (YouTube)</label>
                    <input asp-for="Content.VideoUrl" type="text"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                           placeholder="https://youtube.com/..." />
                </div>
            </div>
        </div>

        @* ===== SEO ===== *@
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
            <h2 class="font-bold text-gray-800 text-lg border-b pb-3">SEO</h2>

            <div>
                <label asp-for="Metadata.MetaTitle" class="block text-sm font-medium text-gray-700 mb-1">Meta Title</label>
                <input asp-for="Metadata.MetaTitle"
                       class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                       placeholder="Để trống = dùng tên sản phẩm" />
            </div>
            <div>
                <label asp-for="Metadata.MetaDesc" class="block text-sm font-medium text-gray-700 mb-1">Meta Description</label>
                <textarea asp-for="Metadata.MetaDesc" rows="2"
                          class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-primary/50"
                          placeholder="Để trống = dùng mô tả ngắn"></textarea>
            </div>
        </div>

        @* ===== THÔNG TIN CHI TIẾT (Rich Editor) ===== *@
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
            <div class="flex items-center justify-between border-b pb-3 mb-5">
                <h2 class="font-bold text-gray-800 text-lg">Thông tin chi tiết</h2>
            </div>
            
            <textarea name="detailsHtml" class="rich-editor hidden">@ViewBag.InitialHtml</textarea>
            <p class="text-xs text-gray-400 mt-2">
                * Hỗ trợ định dạng văn bản, chèn ảnh và chèn video từ URL (YouTube, Vimeo...).
            </p>
        </div>

        @* ===== SUBMIT ===== *@
        <div class="flex items-center gap-3 pt-4">
            <button type="submit"
                    class="bg-primary text-white px-10 py-3.5 rounded-xl font-bold hover:opacity-90 transition shadow-lg flex items-center gap-2">
                <i data-lucide="save" class="w-5 h-5"></i>
                @(isEdit ? "Cập nhật thay đổi" : "Thêm sản phẩm ngay")
            </button>
            <a href="/admin/products" class="px-6 py-3 text-gray-500 hover:text-gray-800 transition font-medium">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>

@* Script được đặt trực tiếp để đảm bảo hoạt động khi dùng làm Partial View *@
<script>
    (function() {
        // Khởi tạo icons Lucide
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Alpine component logic
        window.contentBlocksEditor = function(initialBlocks) {
            return {
                blocks: Array.isArray(initialBlocks) ? initialBlocks : [],
                add(type) {
                    this.blocks.push({ type: type, content: '', url: '', alt: '', uploading: false });
                    this.refreshIcons();
                },
                remove(idx) {
                    this.blocks.splice(idx, 1);
                },
                move(idx, dir) {
                    let to = idx + dir;
                    if (to < 0 || to >= this.blocks.length) return;
                    let arr = [...this.blocks];
                    [arr[idx], arr[to]] = [arr[to], arr[idx]];
                    this.blocks = arr;
                    this.refreshIcons();
                },
                async uploadImage(event, idx) {
                    const file = event.target.files[0];
                    if (!file) return;

                    const block = this.blocks[idx];
                    block.uploading = true;

                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('folder', 'products');

                    // Lấy antiforgery token từ form
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    try {
                        const response = await fetch('/admin/api/upload', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });

                        if (!response.ok) {
                            const error = await response.json();
                            alert(error.message || 'Lỗi upload ảnh');
                        } else {
                            const result = await response.json();
                            block.url = result.url;
                        }
                    } catch (err) {
                        console.error('Upload error:', err);
                        alert('Không thể kết nối máy chủ để upload');
                    } finally {
                        block.uploading = false;
                        event.target.value = ''; // Reset input
                    }
                },
                submitJson() {
                    // Loại bỏ các property tạm như 'uploading' trước khi lưu
                    const cleanBlocks = this.blocks.map(b => {
                        const { uploading, ...rest } = b;
                        return rest;
                    });
                    return JSON.stringify(cleanBlocks);
                },
                refreshIcons() {
                    setTimeout(() => {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }, 50);
                }
            };
        };
    })();
</script>
